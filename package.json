{
  "name": "spacix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPACIX cloud AI creative studio powered by modular model providers and MySQL persistence.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/server.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/cli.ts validate",
    "apps": "node --experimental-strip-types --disable-warning=ExperimentalWarning server/cli.ts apps",
    "app": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/cli.ts app",
    "serve": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/db/migrate.ts",
    "seed:admin": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/cli.ts create-admin",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
