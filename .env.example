PORT=3000
PUBLIC_BASE_URL=

# Master Encryption & Session Signing Keys (32+ byte random secrets, keep server-side only)
SPACIX_ENCRYPTION_KEY=
SPACIX_SESSION_SECRET=

# Optional Default Cloud AI Provider Credentials (can also be managed encrypted in Admin Dashboard)
FAL_KEY=
FAL_WEBHOOK_SECRET=

# MySQL / MariaDB Database Configuration (cPanel or external MySQL 8+ / MariaDB 10.6+)
DATABASE_URL=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=spacix
MYSQL_SSL=false

# Outbound Email / SMTP Configuration (optional; can also be managed in Admin Dashboard)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Initial Super Admin CLI Seeding (never hardcoded; set temporarily when running npm run seed:admin)
SPACIX_ADMIN_EMAIL=
SPACIX_ADMIN_PASSWORD=
SPACIX_ADMIN_NAME=

# Server, Storage & Access Controls
SPACIX_HOST=0.0.0.0
SPACIX_OUT=
SPACIX_DRAFTS=
SPACIX_MAX_RUNS_PER_DAY=
SPACIX_MAX_ACTIVE=
SPACIX_MAX_UPLOAD_MB=100
SPACIX_ALLOWED_HOSTS=
SPACIX_COOKIE_SECURE=